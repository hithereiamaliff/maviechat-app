{
  "name": "@maviechat/contract-probe",
  "version": "0.1.0",
  "private": true,
  "description": "Checks the Open WebUI and DeepTutor contracts against live servers and records response shapes (never content or secrets).",
  "type": "module",
  "scripts": {
    "probe": "tsx src/probe.ts",
    "probe:deeptutor": "tsx src/deeptutor-probe.ts",
    "typecheck": "tsc --noEmit -p .",
    "compare": "tsx src/compare.ts",
    "scratch:setup": "tsx src/scratch-setup.ts",
    "bench:chat": "tsx src/bench-long-chat.ts",
    "probe:opencode": "tsx src/opencode-probe.ts"
  },
  "dependencies": {
    "@maviechat/deeptutor-protocol": "*",
    "@maviechat/opencode-protocol": "*",
    "@maviechat/owui-protocol": "*"
  }
}
