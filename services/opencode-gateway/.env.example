# Your domain for the gateway (its DNS pointing at this computer), and the same with https.
DOMAIN=code.example.com
PUBLIC_URL=https://code.example.com

# Project folders OpenCode may work in from the phone, separated by ":".
ALLOWED_FOLDERS=/home/you/projects

# The OpenCode server on this computer. passwordEnv names the variable that holds its password:
# the same as the OPENCODE_SERVER_PASSWORD it runs with.
OPENCODE_LOGINS='[{"id":"me","name":"OpenCode","url":"http://127.0.0.1:4096","passwordEnv":"OPENCODE_PASSWORD"}]'
OPENCODE_PASSWORD='paste-it-here'

# The name MavieChat shows for this computer. Defaults to its host name.
MACHINE_NAME='My server'
