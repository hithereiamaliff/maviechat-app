{
  "name": "maviechat-app",
  "private": true,
  "description": "MavieChat: a native iPhone client for Open WebUI that follows the web app's layout.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:copies": "node scripts/check-copies.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:licenses && npm run check:copies",
    "bundle": "npm run bundle --workspace @maviechat/mobile",
    "bundle:android": "npm exec --workspace @maviechat/mobile -- expo export --platform android --output-dir dist/android",
    "probe": "npm run probe --workspace @maviechat/contract-probe --",
    "probe:deeptutor": "npm run probe:deeptutor --workspace @maviechat/contract-probe --",
    "probe:opencode": "npm run probe:opencode --workspace @maviechat/contract-probe --",
    "compare": "npm run compare --workspace @maviechat/contract-probe --",
    "scratch:setup": "npm run scratch:setup --workspace @maviechat/contract-probe --",
    "bench:chat": "npm run bench:chat --workspace @maviechat/contract-probe --",
    "ref:sync": "bash scripts/ref-sync.sh",
    "icons": "node scripts/gen-icons.mjs",
    "emoji": "node scripts/gen-emoji.mjs",
    "code-editor": "node scripts/gen-code-editor.mjs",
    "licenses": "node scripts/check-licenses.mjs --write"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "^22.20.5",
    "jscpd": "^5.4.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-worklets": "0.13.0"
  },
  "engines": {
    "node": ">=22"
  }
}
